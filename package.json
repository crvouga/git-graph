{
  "name": "lanes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lanes — a fast, keyboard-first, URL-driven Git graph for the web",
  "bin": {
    "git-graph": "dist/cli/git-graph.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch src/server/main.ts",
    "build": "pnpm build:web && pnpm build:node",
    "build:web": "vite build",
    "build:node": "node scripts/build-node.ts",
    "start": "node dist/server/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "pnpm build && playwright test",
    "fixtures": "node test/fixtures/make-fixtures.ts",
    "perf": "node test/perf/run.ts",
    "test:all": "vitest run && pnpm test:e2e",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "solid-js": "^1.9.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
