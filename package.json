{
  "name": "lanes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lanes — a fast, keyboard-first, URL-driven Git graph for the web",
  "bin": {
    "git-graph": "dist/cli/git-graph.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch src/server/main.ts",
    "dev:server:vault": "personal infra-vault run -- node --watch src/server/main.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static --quiet",
    "ui:shots": "node scripts/ui-shots.ts",
    "ui:compare": "node scripts/ui-compare.ts",
    "ui:publish": "node scripts/ui-publish.ts",
    "build": "pnpm build:web && pnpm build:node",
    "build:web": "vite build",
    "build:node": "node scripts/build-node.ts",
    "start": "node dist/server/server.mjs",
    "vault:check": "node scripts/check-vault.ts",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:migrate:vault": "personal infra-vault run -- node scripts/db-migrate.ts",
    "relay:fingerprint:production": "personal infra-vault run --path secret/auth-relay-agents/lanes-prd/prd -- bun tools/auth-relay/agent.ts fingerprint",
    "relay:register:production": "personal infra-vault run --path secret/auth-relay-agents/lanes-prd/prd -- bun tools/auth-relay/agent.ts register --origin https://auth.chrisvouga.dev --file tools/auth-relay/registration.production.json --ttl-seconds 31536000",
    "relay:fingerprint:local": "personal infra-vault run --path secret/auth-relay-agents/lanes-dev/dev -- bun tools/auth-relay/agent.ts fingerprint",
    "relay:register:local": "personal infra-vault run --path secret/auth-relay-agents/lanes-dev/dev -- bun tools/auth-relay/agent.ts register --origin https://auth-dev.chrisvouga.dev --file tools/auth-relay/registration.localhost.json --ttl-seconds 604800",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "pnpm build && playwright test",
    "test:storybook": "vitest run -c vitest.storybook.config.ts",
    "fixtures": "node test/fixtures/make-fixtures.ts",
    "perf": "node test/perf/run.ts",
    "test:all": "vitest run && pnpm test:e2e",
    "check": "tsc --noEmit -p tsconfig.json",
    "github:plan": "node scripts/github-settings.ts --plan",
    "github:check": "node scripts/github-settings.ts --check",
    "github:apply": "node scripts/github-settings.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "openid-client": "^6.8.9",
    "postgres": "^4.1.0",
    "solid-js": "^1.9.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-mcp": "10.6.6",
    "@storybook/addon-themes": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "storybook": "10.6.6",
    "storybook-solidjs-vite": "10.7.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
