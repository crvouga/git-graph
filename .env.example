# Lanes hosted server configuration. Copy to .env and fill in. Never commit real secrets.
# Secrets come from Vault (https://vault.chrisvouga.dev, secret/personal/<dev|prd>) under
# LANES_-prefixed names, e.g. LANES_SESSION_SECRET; `pnpm dev:server:vault` injects them for you.
# The server accepts either the plain or the LANES_ name. See docs/deploy.md.

# --- Basics ---------------------------------------------------------------
# Port and bind address of the HTTP server.
PORT=8787
HOST=0.0.0.0
# Public origin of the app (scheme + host [+ port], no path). Used for OAuth redirects, CSRF
# checks, cookie security and HSTS. Must match what browsers see.
APP_ORIGIN=http://localhost:8787
# "production" requires APP_ORIGIN and SESSION_SECRET.
NODE_ENV=development
# >= 32 bytes. Encrypts the session cookie and must stay stable across restarts and deploys.
#   openssl rand -base64 48
SESSION_SECRET=

# --- Sign-in through the auth relay (OIDC public client) --------------------------------
# Public settings from `pnpm relay:register:local` (see tools/auth-relay/README.md).
OIDC_ISSUER=https://auth-dev.chrisvouga.dev/realms/projects-dev
OIDC_CLIENT_ID=
# --- PostgreSQL (Vault DATABASE_URL; `pnpm dev:server:vault` injects it) -----------------
# Required: the web client syncs through Zero. Needs wal_level=logical, e.g.
# docker run -p 5432:5432 -e POSTGRES_PASSWORD=pass postgres:17 -c wal_level=logical
DATABASE_URL=
# A dedicated schema allocated by crvouga/personal; never "public" or a pg_* schema.
DATABASE_SCHEMA=lanes
# Production runs zero-cache as an internal-only sidecar (lanes-zero) instead of embedding it.
# Point the proxy at its private URL and share the key (Vault LANES_ZERO_API_KEY). Embedded mode
# (local development) leaves ZERO_CACHE_URL empty and needs no key.
# ZERO_CACHE_URL=http://lanes-zero.railway.internal:4848
# ZERO_API_KEY=
# ZERO_PORT=4848
# ZERO_APP_ID=lanes_zero
# ZERO_UPSTREAM_DB=          # direct (unpooled) URL for zero-cache; defaults to DATABASE_URL
# ZERO_CVR_DB=               # optional pooled URL for client view records
# ZERO_CHANGE_DB=            # optional pooled URL for the change log
# ZERO_REPLICA_FILE=/tmp/lanes-zero/replica.db
# ZERO_ADMIN_PASSWORD=
# >= 32 bytes. Encrypts stored GitHub tokens (Vault LANES_TOKEN_ENCRYPTION_KEY).
TOKEN_ENCRYPTION_KEY=

# --- Connecting GitHub (GitHub App with user-to-server tokens, or an OAuth App) ----------
# See docs/github-app.md. Without these, the app serves public repositories anonymously.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: the App's slug, used by the UI for "install the app" links.
GITHUB_APP_SLUG=
# OAuth App fallback only (GitHub Apps ignore scopes). Default "read:user"; set "repo read:user"
# to let an OAuth App read private repositories.
GITHUB_OAUTH_SCOPES=read:user

# --- Webhooks ---------------------------------------------------------------
# Secret configured on the GitHub App webhook (<APP_ORIGIN>/webhooks/github). Without it,
# webhooks are disabled and real-time updates rely on polling only.
GITHUB_WEBHOOK_SECRET=

# --- Anonymous access -------------------------------------------------------------
# Optional server token used ONLY for repositories verified to be public, to raise the
# anonymous rate limit (60/h per IP → 5000/h). It is never used for private repositories,
# even if it could read them. Prefer a fine-grained token with no repository access at all.
GITHUB_PUBLIC_TOKEN=

# --- GitHub endpoints (GitHub Enterprise Server or tests) ------------------------------
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# --- Files ------------------------------------------------------------------
# Built SPA (pnpm build:web). Relative paths resolve from the working directory.
STATIC_DIR=dist/web

# --- Proxy ------------------------------------------------------------------
# Number of trusted reverse proxies in front of the server (0 = ignore X-Forwarded-For).
TRUST_PROXY=0

# --- Tuning (optional) ------------------------------------------------------------
# Session idle / absolute lifetime in hours.
SESSION_IDLE_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_HOURS=720
# Token buckets: /api per session (or IP), /auth per IP.
RATE_LIMIT_API_BURST=300
RATE_LIMIT_API_PER_SEC=30
RATE_LIMIT_AUTH_BURST=20
RATE_LIMIT_AUTH_PER_SEC=0.2
# Reconciliation poller for repositories with live subscribers.
POLL_FAST_SECONDS=15
POLL_MAX_SECONDS=300
